# ---------------------------------------------------------------------------
# AD-Finance — API server (opsional). Aplikasi PWA-nya sendiri tidak butuh ini.
# Copy to `.env` and export, or pass inline:  DATABASE_URL=… npm run api
# ---------------------------------------------------------------------------

# Port for the API server (default 8787)
PORT=8787

# PostgreSQL connection string. Leave empty to run the in-memory demo store.
#   postgres://user:password@host:5432/pfos
DATABASE_URL=

# Signing secret for JWT access tokens. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Token lifetime in seconds (default 12 hours)
TOKEN_TTL=43200

# CORS origin allowed to call the API (default *). Set to your PWA origin in production.
CORS_ORIGIN=*

# Client-side: paste this into Settings → Sinkronisasi to point the app at your API
# SYNC_ENDPOINT=http://localhost:8787
